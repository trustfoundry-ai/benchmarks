{
  "name": "@trustfoundry-ai/benchmarks-harness",
  "version": "0.6.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./contracts": "./src/core/contracts/index.mjs",
    "./adapters/registry": "./src/core/registry.mjs",
    "./adapters/providers/*": "./src/adapters/providers/*.mjs",
    "./adapters/scorers/*": "./src/adapters/scorers/*.mjs",
    "./adapters/benchmarks/*": "./src/adapters/benchmarks/*.mjs",
    "./artifacts": "./src/core/artifacts.mjs",
    "./testing": "./src/testing/index.mjs",
    "./cli": "./src/cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "configs",
    "data",
    "suites",
    "scripts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "trustfoundry-benchmarks": "bin/benchmarks.mjs"
  },
  "scripts": {
    "benchmark": "node bin/benchmarks.mjs",
    "test": "node --test",
    "verify:results": "node scripts/verify-result-bundles.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
